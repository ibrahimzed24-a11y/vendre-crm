# VENDRE CRM Environment Configuration
# Copy this file to .env and adjust values for your local environment

NODE_ENV=development
PORT=3000

# PostgreSQL Connection String (Docker local default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vendre_crm?schema=public"

# Session & JWT Secret (Generate a strong 32+ character random secret in production)
SESSION_SECRET="vendre_crm_super_secure_development_secret_key_minimum_32_characters_long_123"

# Cookie Configuration
COOKIE_NAME="vendre_session"
COOKIE_SECURE=false

# Default Workspace (Optional fallback)
DEFAULT_WORKSPACE_SLUG="vendre-sales"
